{
  "id": "kanban",
  "name": "Kanban",
  "description": "Simplified Kanban board with To Do / In Progress / Done columns. Flat task structure, no review cycle. Best for small teams or rapid prototyping.",
  "schema": {
    "workItemTypes": [
      { "name": "feature", "label": "Feature", "isLeaf": false, "allowedChildren": ["task", "bug"], "allowedAtRoot": true, "canDecompose": true },
      { "name": "task", "label": "Task", "isLeaf": true, "allowedChildren": [], "allowedAtRoot": true, "canDecompose": false },
      { "name": "bug", "label": "Bug", "isLeaf": true, "allowedChildren": [], "allowedAtRoot": true, "canDecompose": false }
    ],
    "statuses": [
      { "name": "todo", "label": "To Do", "category": "initial" },
      { "name": "in_progress", "label": "In Progress", "category": "active" },
      { "name": "done", "label": "Done", "category": "terminal" },
      { "name": "cancelled", "label": "Cancelled", "category": "terminal" }
    ],
    "transitions": [
      { "from": "todo", "to": "in_progress", "mode": "manual" },
      { "from": "in_progress", "to": "done", "mode": "manual" },
      { "from": "in_progress", "to": "todo", "mode": "manual" },
      { "from": "todo", "to": "cancelled", "mode": "system" },
      { "from": "in_progress", "to": "cancelled", "mode": "system" }
    ],
    "behaviorRules": [
      {
        "id": "kanban-propagate-parent",
        "name": "Auto-complete parent when all children done",
        "priority": 10,
        "trigger": "on_all_children_terminal",
        "action": { "type": "transition", "params": { "targetStatus": "done" } }
      }
    ]
  }
}
