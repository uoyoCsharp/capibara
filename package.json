{
  "name": "capibara",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Powered Organization Orchestration Platform",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @capibara/electron dev",
    "build": "pnpm -r build",
    "build:electron": "pnpm --filter @capibara/electron build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "typescript": "^5.8.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3",
      "esbuild"
    ]
  }
}
