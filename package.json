{
  "name": "capibara",
  "version": "0.1.0",
  "cli_prefix": "cpbr",
  "description": "An automated agent workflow engine for leveraging agentic development.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/main.js",
  "bin": {
    "cpbr": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "commander": "^13.1.0",
    "dotenv": "^16.5.0",
    "emittery": "^1.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "zod": "^3.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "prettier": "^3.4.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
